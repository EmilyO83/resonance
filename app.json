{
  "expo": {
    "name": "Resonance",
    "slug": "resonance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "resonance",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f1a",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f1a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.emilylo.resonance",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0b0f1a"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "ios": {
      "bundleIdentifier": "com.emilylo.resonance",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "9914868a-56cd-4732-8080-6621fa85237b"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/9914868a-56cd-4732-8080-6621fa85237b"
    }
  }
}
