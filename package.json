{
  "name": "resonance-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "node check-imports.js && npm ls expo-asset",
    "apk": "node build-html.js && cd android && gradlew.bat assembleRelease",
    "apk:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "phone": "adb reverse tcp:8081 tcp:8081 && expo start --localhost"
  },
  "dependencies": {
    "expo": "^54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-keep-awake": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-webview": "13.15.0"
  },
  "private": true
}
